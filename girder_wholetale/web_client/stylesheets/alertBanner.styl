.banner {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #f8d7da; /* A light red color */
  color: #721c24; /* A dark red color for the text */
  padding: 15px;
  text-align: center;
  z-index: 1000;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.close-btn {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: #721c24;
}
